# Create .env.local and replace these placeholders with your own values.
# Never commit real keys or paste them into screenshots/reports.

# ── Required: Gemini (existing) ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── ElevenLabs TTS (primary patient voice) ────────────────────────────────
# Sign up at https://elevenlabs.io → Profile → API Key
# Free tier is sufficient for a hackathon demo (~10k chars/month).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Per-patient ElevenLabs voice IDs (from your ElevenLabs voice library).
# Leave empty to disable ElevenLabs for that patient (browser TTS fallback).
ELEVENLABS_JAMES_VOICE_ID=
ELEVENLABS_MARGARET_VOICE_ID=
ELEVENLABS_EMMA_VOICE_ID=
ELEVENLABS_ROBERT_VOICE_ID=

# ── ElevenLabs feature flag ───────────────────────────────────────────────
# Set to "true" to enable ElevenLabs as primary TTS (browser TTS fallback).
# Set to "false" (or remove) to use browser TTS directly — emergency disable.
# NEXT_PUBLIC_ELEVENLABS_TTS=true

# ── Realistic Avatar: ElevenLabs TTS (legacy placeholder) ─────────────────
# Optional: override the default voice ID (defaults to "Sarah" EXAVITQu4vr4xnSDxMaL)
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Realistic Avatar: Wav2Lip service ─────────────────────────────────────
# Base URL of the FastAPI Wav2Lip service.
# During development: run the service on Colab and expose it with ngrok or
# similar. On demo day: point this at your RunPod / Vast.ai endpoint.
# Example: https://abc123.runpod.io or http://localhost:8000
WAV2LIP_SERVICE_URL=http://localhost:8000

# ── Realistic Avatar: Frontend feature flag ───────────────────────────────
# Set to "1" to enable the Realistic Avatar option in the avatar selection
# screen. Leave unset (or set to "") to disable it (GPU offline fallback).
# This is a NEXT_PUBLIC_ var so it's embedded at build time.
NEXT_PUBLIC_WAV2LIP_AVAILABLE=

# ── Static Patient Avatar feature flag ────────────────────────────────────
# Set to "true" to replace the SVG Mii avatar with static portrait photos.
# Set to "false" (or remove) to revert to the original Mii SVG avatar.
# Portraits must exist in public/avatars/{patient}/{expression}.png
# Disable immediately if any issues arise before/during the demo.
NEXT_PUBLIC_STATIC_AVATAR=true
