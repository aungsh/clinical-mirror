# Create .env.local and replace these placeholders with your own values.
# Never commit real keys or paste them into screenshots/reports.

# ── Required: Gemini (existing) ───────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── ElevenLabs TTS (primary patient voice) ────────────────────────────────
# Sign up at https://elevenlabs.io → Profile → API Key
# Free tier is sufficient for a hackathon demo (~10k chars/month).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Per-patient ElevenLabs voice IDs (defaults built-in if omitted).
ELEVENLABS_JAMES_VOICE_ID=cjVigY5qzO86Huf0OWal
ELEVENLABS_ROBERT_VOICE_ID=pqHfZKP75CvOlQylNhV4
ELEVENLABS_MARGARET_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_EMMA_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── ElevenLabs feature flag ───────────────────────────────────────────────
# Set to "true" to enable ElevenLabs as primary TTS (browser TTS fallback).
# Set to "false" (or remove) to use browser TTS directly — emergency disable.
# NEXT_PUBLIC_ELEVENLABS_TTS=true

# ── Realistic Avatar: ElevenLabs TTS (legacy placeholder) ─────────────────
# Optional: override the default voice ID (defaults to "Sarah" EXAVITQu4vr4xnSDxMaL)
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Realistic Avatar: Wav2Lip service ─────────────────────────────────────
# Base URL of the FastAPI Wav2Lip service.
# During development: run the service on Colab and expose it with ngrok or
# similar. On demo day: point this at your RunPod / Vast.ai endpoint.
# Example: https://abc123.runpod.io or http://localhost:8000
WAV2LIP_SERVICE_URL=http://localhost:8000

# ── Realistic Avatar: Frontend feature flag ───────────────────────────────
# Set to "1" to enable the Realistic Avatar option in the avatar selection
# screen. Leave unset (or set to "") to disable it (GPU offline fallback).
# This is a NEXT_PUBLIC_ var so it's embedded at build time.
NEXT_PUBLIC_WAV2LIP_AVAILABLE=

# ── Live Video Patient: Tavus CVI ─────────────────────────────────────────
# Real-time photorealistic patient. Tavus handles speech recognition, the
# patient's replies, the voice and the rendered face over WebRTC.
#
# Setup:
#   1. Sign up at https://tavus.io, open the PAL Maker, create an API key.
#   2. Put the key below. That alone is enough for the feature to work.
#   3. Optional: `npm run tavus:faces` lists stock faces so you can cast each
#      character, and `npm run tavus:pal` pins the conversation pipeline.
#
# Setting TAVUS_API_KEY is what makes the "Live Video Patient" option appear
# on the avatar selection screen (checked at runtime via /api/tavus/status).
TAVUS_API_KEY=

# Fallback Face used when a character has no face of its own.
# r90bbd427f71 is the stock "Anna" face from the Tavus docs.
TAVUS_FACE_ID=r90bbd427f71

# Optional PAL (behaviour + pipeline). Leave blank to let Tavus use its
# default pipeline — the persona is sent per conversation either way.
# Create one with: npm run tavus:pal
TAVUS_PAL_ID=

# Per-character faces. Run `npm run tavus:faces` and pick IDs whose apparent
# age and gender match each patient. Leave blank to fall back to TAVUS_FACE_ID.
TAVUS_MARGARET_FACE_ID=
TAVUS_JAMES_FACE_ID=
TAVUS_EMMA_FACE_ID=
TAVUS_ROBERT_FACE_ID=

# Optional per-character PALs, if you want different behaviour per scenario.
TAVUS_MARGARET_PAL_ID=pfffd1ee0e04
TAVUS_JAMES_PAL_ID=
TAVUS_EMMA_PAL_ID=
TAVUS_ROBERT_PAL_ID=
